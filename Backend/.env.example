# ==============================================================================
# TravelAI Backend Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Groq supplies chat generation; Ollama supplies local RAG embeddings.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
OLLAMA_BASE_URL=http://localhost:11434

# Real-Time Travel Data APIs
# SerpApi is used for live Google Flights, Hotels, and Real-time Search discovery
SERPAPI_API_KEY=your_serpapi_api_key_here

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=travel_ai

# Allowed browser origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local output-token budget; tune to your Groq account's actual quota.
GROQ_OUTPUT_TOKENS_PER_MINUTE=1000

# Dynamic Routing V2. Public demo: run uvicorn with --workers 1.
# Empty URL disables external road lookups and retains labelled distance estimates.
ROUTING_DRIVING_URL=https://router.project-osrm.org
ROUTING_DRIVING_PROFILE=driving
# Configure only with an endpoint actually built for walking; never reuse the car dataset.
ROUTING_WALKING_URL=
ROUTING_WALKING_PROFILE=foot

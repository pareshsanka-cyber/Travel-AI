# ==============================================================================
# TravelAI Backend — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ==============================================================================

# LLM Provider — Groq for chat generation
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_OUTPUT_TOKENS_PER_MINUTE=1000

# RAG Embeddings — Ollama (run locally or on a VM)
# Pull model once: ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# Real-Time Travel Data — SerpApi (flights, hotels, search)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Database — MongoDB (local or Atlas URI)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=travel_ai

# CORS — comma-separated allowed browser origins
# For production, set this to your deployed frontend URL only
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Dynamic Routing V2 (public OSRM demo — no key required)
# Empty URL disables external road lookups and retains labelled distance estimates.
ROUTING_DRIVING_URL=https://router.project-osrm.org
ROUTING_DRIVING_PROFILE=driving
ROUTING_WALKING_URL=
ROUTING_WALKING_PROFILE=foot

# ==============================================================================
# TravelAI Backend Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: Groq (Recommended default) or local Ollama
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
OLLAMA_BASE_URL=http://localhost:11434

# Real-Time Travel Data APIs
# SerpApi is used for live Google Flights, Hotels, and Real-time Search discovery
SERPAPI_API_KEY=your_serpapi_api_key_here

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=travel_ai

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here
